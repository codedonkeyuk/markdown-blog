{
  "name": "@markdown-blog/lib",
  "version": "1.0.16",
  "description": "A static site that converts markdown into blog pages",
  "license": "UNLICENCED",
  "type": "module",
  "publishConfig": {
    "registry": "https://192.168.1.200:3001/api/packages/codedonkeyuk/npm/"
  },
  "bin": {
    "markdown-blog": "./dist/cli.js"
  },
  "scripts": {
    "validate": "prettier . --check && tsc --noEmit && npx cspell README.md",
    "clean": "prettier . --write",
    "prebuild": "npm run validate && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types --experimental-test-module-mocks \"**/*.test.ts\"",
    "coverage": "node --experimental-strip-types --experimental-test-module-mocks --test --experimental-test-coverage \"**/*.test.ts\""
  },
  "devDependencies": {
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/live-server": "^1.2.3",
    "@types/node": "^26.1.1",
    "prettier": "3.9.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cspell": "^10.0.1",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.5.5",
    "lightningcss": "^1.32.0",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "terser": "^5.49.0",
    "vite": "^8.3.5"
  }
}
