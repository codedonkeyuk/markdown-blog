set -e

while read -r local_ref local_sha remote_ref remote_sha
do
  # Allow a first push to a new branch
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  CURRENT_VERSION=$(npm pkg get version | tr -d '"[:space:]')

  OLD_VERSION=$(
    git show "$remote_sha:package.json" |
      node -e '
        let input = "";
        process.stdin.on("data", chunk => input += chunk);
        process.stdin.on("end", () => {
          console.log(JSON.parse(input).version);
        });
      '
  )

  if [ "$CURRENT_VERSION" = "$OLD_VERSION" ]; then
    echo "Push rejected: package version has not changed."
    echo "Version: $CURRENT_VERSION"
    exit 1
  fi

  echo "Version changed: $OLD_VERSION -> $CURRENT_VERSION"
done

exit 0
