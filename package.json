{
  "name": "markdown-blog",
  "version": "1.0.17",
  "description": "A static site that converts markdown into blog pages",
  "license": "UNLICENCED",
  "private": "true",
  "author": "Leigh G",
  "type": "module",
  "exports": {
    "./lib": "./workspace/lib"
  },
  "workspaces": [
    "workspace/lib",
    "workspace/template"
  ],
  "scripts": {
    "validate": "npm run validate --workspaces --if-present && npx cspell README.md",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "cspell": "^10.0.1",
    "husky": "^9.1.7"
  }
}
