{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug TS Tests",
      "program": "${workspaceRoot}/node_modules/node/bin/node",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--test",
        "--experimental-strip-types",
        "--experimental-test-module-mocks",
        "--inspect-brk=9229"
      ],
      "args": ["**/*.test.ts"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
